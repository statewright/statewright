{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "bash ${CURSOR_PLUGIN_ROOT}/hook.sh session-start", "timeout": 5 }
    ],
    "preToolUse": [
      { "command": "bash ${CURSOR_PLUGIN_ROOT}/hook.sh pre-tool", "timeout": 5, "failClosed": true }
    ],
    "postToolUse": [
      { "command": "bash ${CURSOR_PLUGIN_ROOT}/hook.sh post-tool", "timeout": 5 }
    ],
    "stop": [
      { "command": "bash ${CURSOR_PLUGIN_ROOT}/hook.sh stop", "timeout": 5, "loop_limit": 4 }
    ]
  }
}
