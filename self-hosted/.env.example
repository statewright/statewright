# Statewright Self-Hosted Configuration
#
# Copy to .env and modify as needed.

# Gateway listen address (inside container)
# GATEWAY_ADDR=0.0.0.0:3001

# PocketBase URL (internal Docker network)
# PB_URL=http://pocketbase:8090

# Ollama URL (BYO — not included in this stack)
# Point your agent (Claude Code, Codex, Pi) at your Ollama instance.
# OLLAMA_URL=http://host.docker.internal:11434
