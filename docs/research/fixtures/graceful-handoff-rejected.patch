+  const next = f.frames.findIndex(frame => frame.method === "turn/started" && frame.params.turn.id === "turn-2");
+  assert.ok(final >= 0 && terminal > final && next > terminal);
+  assert.ok(f.handoffStatus.some(event => event.schema === "statewright/graceful-handoff/v1" && event.outcome === "completed"));
+  assert.equal((await f.hook("pre-tool")).action, "pass", "new turn must not inherit the old summary gate");
+});
+
+test("hook acknowledgement arriving before native lifecycle notification is retained", async t => {
+  const f = await fixture(t, {gracefulHandoff: true});
+  const state = stateFor("intake", 1, "gpt-6-sol", "high"); f.setState(state);
+  assert.equal((await f.hook("post-tool", "intake")).action, "finish");
+  f.completeTool("statewright_load_workflow", {state_snapshot: state});
+  f.finalAnswer(); f.finish();
+  await until(() => f.injected.length === 1);
+  assert.equal(f.calls.filter(c => c.method === "turn/interrupt").length, 0);
+});
+
+for (const fallback of ["missing-hook", "timeout", "tool-attempt"]) {
+  test(`graceful handoff falls back safely for ${fallback}`, async t => {
+    const f = await fixture(t, {gracefulHandoff: true, gracefulHandoffTimeoutMs: 40, gracefulHookTimeoutMs: 40});
+    const state = stateFor("intake", 1, "gpt-6-sol", "high"); f.setState(state);
+    f.completeTool("statewright_load_workflow", {state_snapshot: state});
+    if (fallback !== "missing-hook") await f.hook("post-tool", "intake");
+    if (fallback === "tool-attempt") assert.equal((await f.hook("pre-tool")).action, "deny");
+    await until(() => f.injected.length === 1);
+    assert.equal(f.calls.filter(c => c.method === "turn/interrupt").length, 1);
+    assert.ok(f.frames.some(frame => frame.method === "turn/completed" && frame.params.turn.status === "interrupted"));
+    assert.ok(f.handoffStatus.some(event => event.outcome === ({"missing-hook": "hook_unavailable", timeout: "timeout", "tool-attempt": "tool_attempt"})[fallback]));
+  });
+}
+
+for (const abort of ["cancel", "failed", "phase-drift", "manual-settings"]) {
+  test(`graceful summary cannot auto-continue after ${abort}`, async t => {
+    const f = await fixture(t, {gracefulHandoff: true});
+    const state = stateFor("intake", 1, "gpt-6-sol", "high"); f.setState(state);
+    f.completeTool("statewright_load_workflow", {state_snapshot: state});
+    await f.hook("post-tool", "intake");
+    if (abort === "cancel") await f.rpc("turn/interrupt", {threadId, turnId: "turn-1"});
+    else if (abort === "manual-settings") await f.rpc("thread/settings/update", {threadId, effort: "low"});
+    else if (abort === "failed") f.notify("turn/completed", {threadId, turn: {id: "turn-1", status: "failed"}});
+    else { f.setState({...state, state_epoch: 2}); f.finish(); }
+    await until(() => f.errors.length > 0);
+    assert.equal(f.calls.filter(c => c.method === "turn/start").length, 1);
+    assert.equal(f.injected.length, 0);
+  });
+}
+
+test("graceful handoff rejects foreign hooks and ignores foreign turn completion", async t => {
+  const f = await fixture(t, {gracefulHandoff: true});
+  assert.equal((await f.hook("pre-tool", null, {}, "bad-token")).status, 401);
+  assert.equal((await f.hook("pre-tool", null, {turnId: "foreign"})).status, 409);
+  const state = stateFor("intake", 1, "gpt-6-sol", "high"); f.setState(state);
+  f.completeTool("statewright_load_workflow", {state_snapshot: state});
