+#!/usr/bin/env node
+import { readFile } from "node:fs/promises";
+import { spawn } from "node:child_process";
+import { fileURLToPath } from "node:url";
+
+const summary = "Statewright Arbiter owns the next phase. End this turn now with a brief factual final summary of the phase just finished (or acknowledge workflow loading). Do not call any more tools or begin the next phase. The Arbiter will start its selected model after this turn completes.";
+const lifecycle = /^(?:mcp__statewright__|mcp__plugin_statewright_statewright__)(statewright_load_workflow|statewright_start|statewright_transition|statewright_force_state)$/;
+
+export function handoffDestination(input) {
+  const tool = lifecycle.exec(input.tool_name ?? "")?.[1];
+  if (!tool) return null;
+  let result = input.tool_response ?? input.tool_result;
+  try {
+    if (typeof result === "string") result = JSON.parse(result);
+    if (!result || result.isError || result.error || input.is_error) return null;
+    if (result.result) result = result.result;
+    if (result.isError || result.error) return null;
+    result = result.structuredContent ?? (result.content
+      ? JSON.parse(result.content.find(entry => entry.type === "text")?.text) : result);
+    if (["statewright_load_workflow", "statewright_start"].includes(tool)) {
+      return result.state_snapshot?.run_id ? result.state_snapshot.state : null;
+    }
+    return result.transitioned === true ? result.to : null;
+  } catch { return null; }
+}
+
+export async function handoffHookDecision(event, input, {environment = process.env, fetchImpl = fetch, read = readFile} = {}) {
+  const threadId = input.thread_id ?? input.session_id;
+  const turnId = input.turn_id;
+  if (typeof threadId !== "string" || !threadId || typeof turnId !== "string" || !turnId) throw new Error("Native hook turn identity is missing");
+  const path = environment.STATEWRIGHT_CLASSIFIER_APPROVAL_RECEIPT;
+  if (!path) throw new Error("Native handoff receipt is missing");
+  const receipt = JSON.parse(await read(path, "utf8"));
+  const endpoint = new URL(receipt.proxyUrl);
+  if (!["ws:", "wss:"].includes(endpoint.protocol) || !["127.0.0.1", "localhost", "[::1]"].includes(endpoint.hostname)
+      || endpoint.username || endpoint.password || !receipt.proxyToken) throw new Error("Invalid native handoff receipt");
+  endpoint.protocol = endpoint.protocol === "wss:" ? "https:" : "http:";
+  endpoint.pathname = "/workflow-handoff-hook"; endpoint.search = ""; endpoint.hash = "";
+  const response = await fetchImpl(endpoint, {method: "POST",
+    headers: {Authorization: `Bearer ${receipt.proxyToken}`, "Content-Type": "application/json"},
+    body: JSON.stringify({threadId, turnId, event,
+      ...(event === "post-tool" ? {destination: handoffDestination(input)} : {})}),
+    signal: AbortSignal.timeout(1500)});
+  const result = await response.json();
+  if (!response.ok || result.threadId !== threadId || result.turnId !== turnId
+      || !["pass", "finish", "deny"].includes(result.action)) throw new Error("Native handoff owner is unavailable");
+  return result.action;
+}
+
+export function handoffHookOutput(event, action, original = "", error = null) {
+  if (event === "pre-tool" && (action === "deny" || error)) return JSON.stringify({hookSpecificOutput: {
+    hookEventName: "PreToolUse", permissionDecision: "deny",
+    permissionDecisionReason: error ? `Statewright handoff guard unavailable: ${error.message}. No tool was executed.` : summary}});
+  if (action !== "finish") return original;
+  if (event === "stop") return ""; // Allow the actual final answer to complete.
+  if (event === "post-tool") return JSON.stringify({hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: summary}});
+  return original;
+}
+
+async function originalHook(event, input) {
+  const child = spawn("bash", [fileURLToPath(new URL("../hook.sh", import.meta.url)), event], {
+    env: {...process.env, STATEWRIGHT_HANDOFF_HOOK_INNER: "1"}, stdio: ["pipe", "pipe", "inherit"]});
+  let output = "";
+  child.stdout.on("data", chunk => { output += chunk; });
+  const closed = new Promise((resolve, reject) => { child.once("error", reject); child.once("close", resolve); });
+  child.stdin.end(input);
+  const code = await closed;
+  if (code !== 0) throw new Error(`Statewright hook exited ${code}`);
+  return output;
+}
+
+async function main() {
+  const event = process.argv[2];
+  let raw = "";
+  for await (const chunk of process.stdin) raw += chunk;
+  const input = JSON.parse(raw);
+  // Arm before running the ordinary post hook, but retain all of its cache,
+  // routing and telemetry side effects. Only its continuation prose is replaced.
+  let action = "pass", error = null;
+  try { action = await handoffHookDecision(event, input); } catch (caught) { error = caught; }
+  if (event === "pre-tool" && (error || action === "deny") || event === "stop" && action === "finish") {
+    process.stdout.write(handoffHookOutput(event, action, "", error)); return;
+  }
+  const original = await originalHook(event, raw);
+  process.stdout.write(handoffHookOutput(event, action, original, error));
+}
+if (process.argv[1] === fileURLToPath(import.meta.url)) main().catch(error => {
+  process.stderr.write(`[statewright] handoff hook failed: ${error.message}\n`);
+  process.exitCode = 2;
+});
