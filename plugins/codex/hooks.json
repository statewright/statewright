{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $(dirname $0)/hook.sh user-prompt",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $(dirname $0)/hook.sh pre-tool",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $(dirname $0)/hook.sh post-tool",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash $(dirname $0)/capture.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $(dirname $0)/hook.sh stop",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
