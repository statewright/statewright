{
  "id": "agentic-engineering-default-v1",
  "initial": "intake",
  "context": {
    "trim": {
      "default_profile": "low",
      "usage_measurement": "observed_only",
      "weekly_budget_enforcement": "operator_observed_not_global",
      "local_first": "casa/qwen3.8-27b",
      "hosted_routine_fallback": "openai-codex/gpt-5.6-terra",
      "hosted_critical_fallback": "openai-codex/gpt-5.6-sol"
    }
  },
  "meta": {
    "version": 2,
    "task_type": "agentic_engineering",
    "danger_level": "moderate",
    "capture_output": true,
    "default_model": "openai-codex/gpt-5.6-terra",
    "trim_policy": "qwen-first-terra-fallback",
    "frontier_slot_policy": "one-active-slot",
    "weekly_budget_policy": "advisory_until_a_shared_supervisor_gate_exists"
  },
  "states": {
    "intake": {
      "instructions": "Establish the requested outcome, repository boundary, irreversible actions, acceptance evidence, and whether the work can be split into independent bounded branches. Do not edit. In low trim, every proposed branch must name its model lane and stopping condition.",
      "allowed_tools": ["Read", "Grep", "Glob"],
      "model": "casa/qwen3.8-27b",
      "thinking_level": "low",
      "model_ladder": [
        {"model": "casa/qwen3.8-27b", "thinking_level": "low", "health_url": "https://qwen3-8-27b-affinity.ollama.casa.enhasa.cloud/health", "requires_provider_switch": true},
        {"model": "openai-codex/gpt-5.6-terra", "thinking_level": "low"}
      ],
      "max_iterations": 2,
      "context_budget_bytes": 12000,
      "safe_next": "blocked",
      "on": {"READY": "localize", "BLOCKED": "blocked"}
    },
    "localize": {
      "instructions": "Find the smallest responsible files, contracts, tests, and runtime evidence. Keep each investigation bounded and return a compact evidence packet. Do not edit or make a broad speculative plan.",
      "allowed_tools": ["Read", "Grep", "Glob", "Bash"],
      "allowed_commands": ["git status", "git diff", "rg", "find", "ls", "pwd"],
      "model": "casa/qwen3.8-27b",
      "thinking_level": "medium",
      "model_ladder": [
        {"model": "casa/qwen3.8-27b", "thinking_level": "medium", "health_url": "https://qwen3-8-27b-affinity.ollama.casa.enhasa.cloud/health", "requires_provider_switch": true},
        {"model": "openai-codex/gpt-5.6-terra", "thinking_level": "medium"}
      ],
      "max_iterations": 3,
      "context_budget_bytes": 24000,
      "safe_next": "blocked",
      "on": {"LOCALIZED": "baseline", "ESCALATE": "terra_escalation", "BLOCKED": "blocked"}
    },
    "baseline": {
      "instructions": "Record clean-tree status, the relevant baseline behavior, validation command, and the exact success criterion. If the task spans an integration seam or Qwen has already exhausted two distinct hypotheses, escalate with evidence rather than retrying.",
      "allowed_tools": ["Read", "Grep", "Glob", "Bash"],
      "allowed_commands": ["git status", "git diff", "git log", "rg", "find", "ls", "pwd", "task", "npm", "pnpm", "cargo", "go", "pytest"],
      "model": "casa/qwen3.8-27b",
      "thinking_level": "medium",
      "model_ladder": [
        {"model": "casa/qwen3.8-27b", "thinking_level": "medium", "health_url": "https://qwen3-8-27b-affinity.ollama.casa.enhasa.cloud/health", "requires_provider_switch": true},
        {"model": "openai-codex/gpt-5.6-terra", "thinking_level": "medium"}
      ],
      "max_iterations": 3,
      "context_budget_bytes": 32000,
      "safe_next": "blocked",
      "on": {"BASELINED": "implement", "ESCALATE": "terra_escalation", "BLOCKED": "blocked"}
    },
    "implement": {
      "instructions": "Make only the scoped change needed for the declared criterion. One agent owns mutations; parallel branches are read-only or submit a narrowly bounded patch. Do not expand a local task into a refactor. If cross-service coupling or two failed hypotheses emerge, hand off to Terra with the evidence packet.",
      "allowed_tools": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
      "model": "casa/qwen3.8-27b",
      "thinking_level": "medium",
      "model_ladder": [
        {"model": "casa/qwen3.8-27b", "thinking_level": "medium", "health_url": "https://qwen3-8-27b-affinity.ollama.casa.enhasa.cloud/health", "requires_provider_switch": true},
        {"model": "openai-codex/gpt-5.6-terra", "thinking_level": "medium"}
      ],
      "max_iterations": 3,
      "max_edit_lines": 400,
      "max_files_per_state": 12,
      "context_budget_bytes": 48000,
      "safe_next": "blocked",
      "on": {"IMPLEMENTED": "validate", "HYPOTHESIS_REJECTED": "localize", "ESCALATE": "terra_escalation", "BLOCKED": "blocked"}
    },
    "terra_escalation": {
      "instructions": "This is the explicit hosted recovery lane. Enter only with a compact evidence packet showing that the task crossed an integration boundary or that two materially different Qwen hypotheses failed. For a persistent Qwen App Server thread, restart into an OpenAI-backed transport; cross-provider switching inside that thread is intentionally refused. Resolve the bounded question, then return to the appropriate state.",
      "allowed_tools": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
      "model": "openai-codex/gpt-5.6-terra",
      "thinking_level": "medium",
      "max_iterations": 2,
      "context_budget_bytes": 48000,
      "safe_next": "blocked",
      "on": {"RESOLVED": "implement", "RELOCALIZE": "localize", "BLOCKED": "blocked"}
    },
    "validate": {
      "instructions": "Run the declared relevant validation and inspect the actual diff. A command merely starting, a partial check, or an unrelated pass is not validation. Return to localization on contradictory or insufficient evidence.",
      "allowed_tools": ["Read", "Grep", "Glob", "Bash"],
      "model": "casa/qwen3.8-27b",
      "thinking_level": "medium",
      "model_ladder": [
        {"model": "casa/qwen3.8-27b", "thinking_level": "medium", "health_url": "https://qwen3-8-27b-affinity.ollama.casa.enhasa.cloud/health", "requires_provider_switch": true},
        {"model": "openai-codex/gpt-5.6-terra", "thinking_level": "medium"}
      ],
      "max_iterations": 2,
      "context_budget_bytes": 32000,
      "safe_next": "blocked",
      "on": {"VALIDATED": "review", "VALIDATION_FAILED": "localize", "BLOCKED": "blocked"}
    },
    "review": {
      "instructions": "Perform an independent, evidence-led review. Check scope drift, correctness, credentials and leakage, unsafe cleanup, missing negative coverage, and false-success claims. Qwen may perform the first bounded pass; Terra is the ordinary hosted fallback. Escalate to frontier review only for a named, high-consequence question and explicit approval. Do not edit.",
      "allowed_tools": ["Read", "Grep", "Glob", "Bash"],
      "allowed_commands": ["git status", "git diff", "git log", "rg", "find", "ls", "pwd"],
      "model": "casa/qwen3.8-27b",
      "thinking_level": "medium",
      "model_ladder": [
        {"model": "casa/qwen3.8-27b", "thinking_level": "medium", "health_url": "https://qwen3-8-27b-affinity.ollama.casa.enhasa.cloud/health", "requires_provider_switch": true},
        {"model": "openai-codex/gpt-5.6-terra", "thinking_level": "medium"}
      ],
      "max_iterations": 1,
      "context_budget_bytes": 36000,
      "safe_next": "blocked",
      "on": {
        "APPROVED": "record",
        "REJECTED": "localize",
        "FRONTIER_ESCALATION": {
          "target": "frontier_review",
          "requires_approval": true,
          "approval_message": "A named high-consequence review question remains after the Qwen/Terra pass. Approve one bounded Sol (or separately selected Astra) review turn."
        },
        "BLOCKED": "blocked"
      }
    },
    "frontier_review": {
      "instructions": "Answer only the approved high-consequence review question from the compact evidence packet. This is a single frontier slot, not a second general review. Do not edit, broaden scope, or claim a release decision without the relevant human approval.",
      "allowed_tools": ["Read", "Grep", "Glob", "Bash"],
      "allowed_commands": ["git status", "git diff", "git log", "rg", "find", "ls", "pwd"],
      "model": "openai-codex/gpt-5.6-sol",
      "thinking_level": "high",
      "max_iterations": 1,
      "context_budget_bytes": 36000,
      "safe_next": "blocked",
      "on": {"APPROVED": "record", "REJECTED": "localize", "BLOCKED": "blocked"}
    },
    "record": {
      "instructions": "Record the final evidence chain: scope, baseline, changed files, exact validation, review disposition, remaining risks, and required human action. Do not claim a deploy, release, commit, or approval that did not occur.",
      "allowed_tools": ["Read", "Grep", "Glob", "Bash"],
      "allowed_commands": ["git status", "git diff", "git log", "rg", "find", "ls", "pwd"],
      "model": "casa/qwen3.8-27b",
      "thinking_level": "low",
      "model_ladder": [
        {"model": "casa/qwen3.8-27b", "thinking_level": "low", "health_url": "https://qwen3-8-27b-affinity.ollama.casa.enhasa.cloud/health", "requires_provider_switch": true},
        {"model": "openai-codex/gpt-5.6-terra", "thinking_level": "low"}
      ],
      "max_iterations": 2,
      "context_budget_bytes": 18000,
      "safe_next": "blocked",
      "on": {"RECORDED": "commit", "BLOCKED": "blocked"}
    },
    "commit": {
      "instructions": "Create one coherent commit only after the evidence chain is recorded and the working tree contains no unrelated changes. Do not push, deploy, rewrite history, or bypass a required human approval.",
      "allowed_tools": ["Read", "Grep", "Glob", "Bash"],
      "allowed_commands": ["git status", "git diff", "git diff --check", "git add", "git commit"],
      "model": "casa/qwen3.8-27b",
      "thinking_level": "low",
      "model_ladder": [
        {"model": "casa/qwen3.8-27b", "thinking_level": "low", "health_url": "https://qwen3-8-27b-affinity.ollama.casa.enhasa.cloud/health", "requires_provider_switch": true},
        {"model": "openai-codex/gpt-5.6-terra", "thinking_level": "low"}
      ],
      "max_iterations": 1,
      "context_budget_bytes": 16000,
      "safe_next": "blocked",
      "on": {"COMMITTED": "completed", "BLOCKED": "blocked"}
    },
    "completed": {"type": "final"},
    "blocked": {"type": "final"}
  },
  "guards": {}
}
