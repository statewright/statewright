+// A native hook acknowledgement is required before permitting a summary-only
+// tail. Never infer enforcement from a prompt, gateway name, or elapsed time.
+export class GracefulHandoffGate {
+  constructor() { this.turns = new Map(); }
+  entry(threadId, turnId) {
+    const current = this.turns.get(threadId);
+    if (current && current.turnId !== turnId) return null;
+    if (current) return current;
+    const entry = {turnId, acknowledged: false, observed: false, outcome: null, waiters: new Set()};
+    this.turns.set(threadId, entry);
+    return entry;
+  }
+  wake(entry) { for (const wake of entry.waiters) wake(); }
+  acknowledge(threadId, turnId, destination) {
+    const entry = this.entry(threadId, turnId);
+    if (!entry || entry.destination && entry.destination !== destination) throw new Error("Stale handoff hook acknowledgement");
+    entry.destination = destination;
+    entry.acknowledged = true;
+    this.wake(entry);
+  }
+  begin(threadId, turnId, destination) {
+    const entry = this.entry(threadId, turnId);
+    if (!entry || entry.destination && entry.destination !== destination) throw new Error("Conflicting handoff destination");
+    entry.destination = destination;
+    entry.observed = true;
+    return entry;
+  }
+  pending(threadId, turnId) {
+    const entry = this.turns.get(threadId);
+    return entry?.turnId === turnId ? entry : null;
+  }
+  settle(threadId, turnId, outcome) {
+    const entry = this.pending(threadId, turnId);
+    if (!entry || entry.outcome) return;
+    entry.outcome = outcome;
+    this.wake(entry);
+  }
+  async wait(entry, predicate, timeoutMs) {
+    if (predicate(entry)) return true;
+    return new Promise(resolve => {
+      const done = value => { clearTimeout(timer); entry.waiters.delete(wake); resolve(value); };
+      const wake = () => { if (predicate(entry)) done(true); };
+      const timer = setTimeout(() => done(false), timeoutMs);
+      entry.waiters.add(wake);
+      wake();
+    });
+  }
+  clear(threadId, turnId) {
+    const entry = this.pending(threadId, turnId);
+    if (!entry) return;
+    this.settle(threadId, turnId, "cancelled");
+    this.turns.delete(threadId);
+  }
+  close() { for (const [threadId, entry] of this.turns) this.clear(threadId, entry.turnId); }
+}
